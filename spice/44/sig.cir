echo "RES sig_3_vdrms $&vdrms"
echo "RES sig_3_v8rms $&v8rms"
echo "RES sig_3_vdmax $&vdmax"
echo "RES sig_3_vdmin $&vdmin"
echo "RES sig_3_ilmax $&ilmax"
echo "RES sig_3_ilmin $&ilmin"
echo "RES sig_3_a1 $&a1"
echo "RES sig_3_b1 $&b1"
echo "RES sig_3_amp 1.0"
wrdata sig_vg.txt v(sig) v(s) v(t) v(in1) v(o1) vd i(L1)
alter @VS[sin] = [ 0 1.25 400 ]
tran 20n 5.5m 0 50n
let vd = v(x1)-v(x2)
let v8 = v(y)-v(x2)
let vsn = vd*sin(2*pi*400*time)
let vcs = vd*cos(2*pi*400*time)
