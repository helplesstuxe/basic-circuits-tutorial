echo "RES sig_2_vdrms $&vdrms"
echo "RES sig_2_v8rms $&v8rms"
echo "RES sig_2_vdmax $&vdmax"
echo "RES sig_2_vdmin $&vdmin"
echo "RES sig_2_ilmax $&ilmax"
echo "RES sig_2_ilmin $&ilmin"
echo "RES sig_2_a1 $&a1"
echo "RES sig_2_b1 $&b1"
echo "RES sig_2_amp 0.75"
alter @VS[sin] = [ 0 1.0 400 ]
tran 20n 5.5m 0 50n
let vd = v(x1)-v(x2)
let v8 = v(y)-v(x2)
let vsn = vd*sin(2*pi*400*time)
let vcs = vd*cos(2*pi*400*time)
