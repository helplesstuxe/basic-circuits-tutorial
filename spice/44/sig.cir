echo "RES sig_5_a1 $&a1"
echo "RES sig_5_b1 $&b1"
echo "RES sig_5_amp 1.5"
alter @VS[sin] = [ 0 2.0 400 ]
tran 20n 5.5m 0 50n
let vd = v(x1)-v(x2)
let v8 = v(y)-v(x2)
let vsn = vd*sin(2*pi*400*time)
let vcs = vd*cos(2*pi*400*time)
let isq = i(Vam)
meas tran iavg avg i(Vam) from=3m to=5.5m
